# LLM — set LLM_PROVIDER to force a backend (auto picks first configured key)
LLM_PROVIDER=auto
# auto | heuristic | anthropic | openai | ilmu

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_PARSE_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_ANALYSIS_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_PARSE_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o

# Ilmu (Malaysia sovereign LLM) — OpenAI-compatible API
ILMU_API_KEY=
ILMU_BASE_URL=https://api.ilmu.ai/v1
ILMU_PARSE_MODEL=ilmu-nemo-nano
ILMU_ANALYSIS_MODEL=nemo-super
# Databases (optional — defaults to SQLite in backend/data/)
DATABASE_URL=
NEON_DATABASE_URL=postgresql://user:pass@pw.neon.tech/nexusops
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJhbGc...

# Redis (local Docker uses REDIS_URL; Upstash for serverless)
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=token_xxx

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=xxx
SLACK_APP_ID=A0xxx
SLACK_CHANNEL_ID=C0xxx

# FastAPI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
