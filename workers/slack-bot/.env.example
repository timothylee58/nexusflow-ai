SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=xxx
# Optional: Socket Mode (recommended for dev — avoids public URL requirement)
# SLACK_APP_LEVEL_TOKEN=xapp-...

# NexusFlow backend URL (internal Docker network name or public URL)
NEXUSFLOW_API_URL=http://backend:8000

# Port the Bolt app listens on for Slack HTTP events (not needed in socket mode)
PORT=3001
