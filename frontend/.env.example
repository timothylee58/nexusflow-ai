NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by Next server (e.g. in Docker): service hostname on the compose network
# INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_SLACK_APP_ID=A0xxx

# Bearer token — must match backend API_KEY when auth is enabled
NEXT_PUBLIC_API_KEY=

# Default tenant org-id sent as X-Org-ID header; overridable per user via the org switcher
NEXT_PUBLIC_ORG_ID=default

# Caller ID used by the user management page (admin Slack user ID or email)
NEXT_PUBLIC_CALLER_ID=dashboard_admin
